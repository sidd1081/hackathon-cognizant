# Python
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Secrets — never bake into the image (injected via compose env_file at runtime)
.env
.env.*
!.env.example

# Generated data artifacts — rebuilt/persisted in the runtime volume
data/processed/
data/vectorstore/
data/*.db
data/*.db-journal

# Docs / misc not needed in the image
tests/
docs/
uv.lock
