# Build context for the root (Hugging Face Spaces) Dockerfile.
.git/
**/__pycache__/
**/*.pyc
**/.venv/
**/venv/
**/node_modules/
frontend/dist/
frontend/.vite/
backend/data/processed/
backend/data/vectorstore/
backend/data/*.db
backend/data/*.db-journal
**/.env
**/.env.*
!**/.env.example
*.pptx
~$*
