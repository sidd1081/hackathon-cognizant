# Root safety-net ignores (backend/ and frontend/ have their own too).

# --- Secrets / env ---
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# --- Node ---
node_modules/
dist/
dist-ssr/
.vite/

# --- Tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- MS Office temp / lock files ---
~$*
